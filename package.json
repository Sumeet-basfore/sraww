{
  "name": "sraww",
  "version": "0.1.0",
  "private": true,
  "description": "Local, single-user Excalidraw-style whiteboard with AI assistance and architecture diagrams.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "predev": "node scripts/copy-excalidraw-fonts.mjs",
    "dev": "concurrently -n server,client -c blue,magenta \"tsx watch --env-file-if-exists=.env src/server/index.ts\" \"vite\"",
    "prebuild": "node scripts/copy-excalidraw-fonts.mjs",
    "build": "npm run typecheck && vite build",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-excalidraw-fonts.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "dependency-cruiser": "^18.9.0",
    "elkjs": "^0.12.1",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "mathjax": "^4.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
