# Copy to .env and adjust. This file contains no secrets; the app uses your
# logged-in Claude Code and Codex CLIs, so no API keys are needed.
PORT=4317
DIAGRAMS_DIR=./data/diagrams
AI_PROVIDER=claude
CLAUDE_BIN=claude
CODEX_BIN=codex
# Optional model overrides. Leave empty to use each CLI's default.
CLAUDE_MODEL=
CODEX_MODEL=
AI_TIMEOUT_MS=120000
# The AI tools page saves its choices here. Only the tool, model and effort are stored.
AI_SETTINGS_FILE=./data/ai-settings.json
